# Ignore everything, then allow back only code and small summaries.
*
!.gitignore
!*.md
!scripts/
!scripts/**
!metadata/
!metadata/**
!results/
results/*
!results/*.tsv
# large intermediates that are tsv but must stay out
results/clusters_*.tsv
# per-gene tables, too large for the repo
results/rep_classes.tsv
results/completeness_reps.tsv
results/supported_cds_lengths.tsv
results/step13_nrclust20260128_hits.tsv
results/antifam_hits.tblout
CHATINDEX.md
# per-gene tables, too large for the repo
results/fourway_classes.tsv
results/gene_taxonomy.tsv
results/unk_clusters_50.tsv
CLAUDE.md
PROJECT_LOG.md
# scripts of other tracks (Basidiobolus detection, Dallas paper, MAG deposit) stay on the cluster only
scripts/basid_*
scripts/dallas*
scripts/mag*
scripts/inspect_map_bas.sh
scripts/locate_basid_mapping.py
scripts/locate_basid_readtable.py
scripts/fix_dup_bank_20261007.py
scripts/__pycache__/
